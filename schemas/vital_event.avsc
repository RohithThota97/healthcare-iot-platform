{
  "type": "record",
  "name": "VitalEvent",
  "namespace": "com.healthcare.iot.v1",
  "doc": "De-identified bedside measurement envelope; no direct identifiers are permitted.",
  "fields": [
    {"name": "event_id", "type": "string"},
    {"name": "event_time", "type": {"type": "long", "logicalType": "timestamp-millis"}},
    {"name": "patient_token", "type": "string"},
    {"name": "encounter_token", "type": "string"},
    {"name": "device_token", "type": "string"},
    {"name": "metric", "type": {"type": "enum", "name": "Metric", "symbols": ["HR", "SPO2", "ECG", "SBP", "DBP", "RESP", "TEMP"]}},
    {"name": "value", "type": "double"},
    {"name": "unit", "type": "string"},
    {"name": "sample_rate_hz", "type": ["null", "double"], "default": null},
    {"name": "quality", "type": {"type": "enum", "name": "Quality", "symbols": ["UNASSESSED", "VALID", "SUSPECT", "REJECTED"]}, "default": "UNASSESSED"},
    {"name": "schema_version", "type": "string", "default": "1.0.0"}
  ]
}